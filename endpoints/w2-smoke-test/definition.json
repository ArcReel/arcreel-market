{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "W2 Smoke Test",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "官方服务上线实测：验证一键提交链路，验证后关闭，不会合并。Launch smoke test, will be closed without merging."
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v1/videos",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}"
    },
    "extract": {
      "task_id": [
        "$.id"
      ],
      "error": [
        "$.error.message"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v1/videos/{{ task_id }}",
    "extract": {
      "status": [
        "$.status"
      ],
      "video_url": [
        "$.url"
      ],
      "error": [
        "$.error.message"
      ]
    }
  },
  "capabilities": {
    "first_frame": false,
    "max_reference_images": 0
  }
}